{#
/**
 * @file
 * Pager for the data table; same class names as core's pager.html.twig
 * plus .pager__label on the visible First/Previous/Next/Last text, which
 * themes can hide on narrow screens (the icons and visually hidden labels
 * remain).
 *
 * Available variables:
 * - items: first, previous, pages (keyed by 1-based page number), next,
 *   last; each with an href.
 * - current: The current page number.
 * - total: Total number of pages.
 * - ellipses: previous / next booleans.
 */
#}
{% if items %}
  <nav class="pager" aria-label="{{ 'Data table pagination'|t }}">
    <ul class="pager__items">
      {% if items.first %}
        <li class="pager__item pager__item--first">
          <a href="{{ items.first.href }}" title="{{ 'Go to first page'|t }}">
            <span class="visually-hidden">{{ 'First page'|t }}</span>
            {{ include('dkan_catalog_ui:icon', {name: 'chevrons-left'}, with_context = false) }}<span class="pager__label" aria-hidden="true">{{ 'First'|t }}</span>
          </a>
        </li>
      {% endif %}
      {% if items.previous %}
        <li class="pager__item pager__item--previous">
          <a href="{{ items.previous.href }}" title="{{ 'Go to previous page'|t }}" rel="prev">
            <span class="visually-hidden">{{ 'Previous page'|t }}</span>
            {{ include('dkan_catalog_ui:icon', {name: 'chevron-left'}, with_context = false) }}<span class="pager__label" aria-hidden="true">{{ 'Previous'|t }}</span>
          </a>
        </li>
      {% endif %}
      {% if ellipses.previous %}
        <li class="pager__item pager__item--ellipsis" role="presentation">&hellip;</li>
      {% endif %}
      {% for key, item in items.pages %}
        <li class="pager__item{{ current == key ? ' is-active' : '' }}">
          <a href="{{ item.href }}" title="{{ current == key ? 'Current page'|t : 'Go to page @key'|t({'@key': key}) }}"{{ current == key ? ' aria-current="page"' }}>
            <span class="visually-hidden">{{ 'Page'|t }}</span>
            {{- key -}}
          </a>
        </li>
      {% endfor %}
      {% if ellipses.next %}
        <li class="pager__item pager__item--ellipsis" role="presentation">&hellip;</li>
      {% endif %}
      {% if items.next %}
        <li class="pager__item pager__item--next">
          <a href="{{ items.next.href }}" title="{{ 'Go to next page'|t }}" rel="next">
            <span class="visually-hidden">{{ 'Next page'|t }}</span>
            <span class="pager__label" aria-hidden="true">{{ 'Next'|t }}</span>{{ include('dkan_catalog_ui:icon', {name: 'chevron-right'}, with_context = false) }}
          </a>
        </li>
      {% endif %}
      {% if items.last %}
        <li class="pager__item pager__item--last">
          <a href="{{ items.last.href }}" title="{{ 'Go to last page'|t }}">
            <span class="visually-hidden">{{ 'Last page'|t }}</span>
            <span class="pager__label" aria-hidden="true">{{ 'Last'|t }}</span>{{ include('dkan_catalog_ui:icon', {name: 'chevrons-right'}, with_context = false) }}
          </a>
        </li>
      {% endif %}
    </ul>
  </nav>
{% endif %}
