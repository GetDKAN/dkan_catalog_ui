{% set has_format = fields|filter(field => field.format is not empty)|length > 0 %}
{# Focusable region so keyboard users can scroll a wide table (WCAG 2.1.1). #}
<div class="dcu-data-dictionary"{% if fields is not empty %} tabindex="0" role="region" aria-label="{{ title ?: 'Data dictionary'|t }}"{% endif %}>
  {% if title and (show_title is not defined or show_title) %}<h3 class="dcu-data-dictionary__heading">{{ title }}</h3>{% endif %}
  {% if fields is empty %}
  <p class="dcu-data-dictionary__empty">{{ 'This data dictionary defines no fields.'|t }}</p>
  {% else %}
  <table class="dcu-data-dictionary__table">
    <thead>
      <tr>
        <th scope="col">{{ 'Name'|t }}</th>
        <th scope="col">{{ 'Title'|t }}</th>
        <th scope="col">{{ 'Type'|t }}</th>
        {% if has_format %}<th scope="col">{{ 'Format'|t }}</th>{% endif %}
        <th scope="col">{{ 'Description'|t }}</th>
      </tr>
    </thead>
    <tbody>
      {% for field in fields %}
        <tr>
          <td><code>{{ field.name }}</code></td>
          <td>{{ field.title }}</td>
          <td>{{ field.type }}</td>
          {% if has_format %}<td>{{ field.format }}</td>{% endif %}
          <td>{{ field.description }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</div>
