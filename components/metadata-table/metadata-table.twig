<div class="dcu-metadata-table">
  {% if heading %}<h3 class="dcu-metadata-table__heading">{{ heading }}</h3>{% endif %}
  <table class="dcu-metadata-table__table">
    <tbody>
      {% for row in rows %}
        <tr>
          <th scope="row">{{ row.label }}</th>
          <td>{% if row.href %}<a href="{{ row.href }}">{{ row.value }}</a>{% else %}{{ row.value }}{% endif %}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
