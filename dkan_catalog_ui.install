<?php

/**
 * @file
 * Install hooks for the DKAN Catalog UI module.
 */

use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\dkan_catalog_ui\Alias\DatasetAliasManagerInterface;
use Drupal\dkan_catalog_ui\Hook\EntityHooks;
use Drupal\search_api\Entity\Index;
use Drupal\search_api\Item\Field;

/**
 * Implements hook_install().
 *
 * Orders the dataset page sections on the default display, backfills
 * /dataset/{uuid} aliases for existing datasets, adds the format index
 * field and removes the legacy "Datasets" menu link. The post-update that
 * removes the link is recorded as run on a fresh install, so it is called
 * here too.
 */
function dkan_catalog_ui_install(): void {
  $display = EntityViewDisplay::load('node.data.default');
  if ($display) {
    $weights = [
      EntityHooks::FIELD_HEADER => 0,
      EntityHooks::FIELD_PREVIEW => 10,
      EntityHooks::FIELD_OVERVIEW => 20,
      EntityHooks::FIELD_DATA_DICTIONARY => 30,
      EntityHooks::FIELD_API => 40,
    ];
    foreach ($weights as $field => $weight) {
      // The preview field belongs to the preview submodule; only reorder it
      // when it is already on the display.
      if ($field === EntityHooks::FIELD_PREVIEW && !$display->getComponent($field)) {
        continue;
      }
      $display->setComponent($field, ['weight' => $weight]);
    }
    $display->removeComponent(EntityHooks::FIELD_CARD);
    $display->save();
  }

  \Drupal::service(DatasetAliasManagerInterface::class)->backfill();
  dkan_catalog_ui_ensure_format_index_field();
  \Drupal::moduleHandler()->loadInclude('dkan_catalog_ui', 'php', 'dkan_catalog_ui.post_update');
  dkan_catalog_ui_remove_search_menu_link();
}

/**
 * Implements hook_uninstall().
 *
 * Removes what install and the presave hook created: the managed
 * /dataset/{uuid} aliases (only those matching their node's uuid), the
 * format index field when this module added it, and this module's
 * components on the default display. Aliases are removed first so that
 * dkan_js_frontend's /dataset/{id} route is reachable again afterwards.
 */
function dkan_catalog_ui_uninstall(): void {
  dkan_catalog_ui_remove_dataset_aliases();

  $state = \Drupal::state();
  if ($state->get(EntityHooks::FORMAT_FIELD_STATE_KEY)) {
    $index = Index::load('dkan');
    if ($index && $index->getField('distribution__item__format')) {
      $index->removeField('distribution__item__format');
      $index->save();
      $index->reindex();
    }
    $state->delete(EntityHooks::FORMAT_FIELD_STATE_KEY);
  }

  $display = EntityViewDisplay::load('node.data.default');
  if ($display) {
    $fields = [
      EntityHooks::FIELD_HEADER,
      EntityHooks::FIELD_OVERVIEW,
      EntityHooks::FIELD_DATA_DICTIONARY,
      EntityHooks::FIELD_API,
    ];
    foreach ($fields as $field) {
      $display->removeComponent($field);
    }
    $display->save();
  }
}

/**
 * Delete the managed /dataset/{uuid} aliases.
 *
 * An alias is managed when it equals the prefix plus the uuid of the node
 * its path points to; any other /dataset/... alias is left alone.
 *
 * @return int
 *   Number of aliases deleted.
 */
function dkan_catalog_ui_remove_dataset_aliases(): int {
  $entityTypeManager = \Drupal::entityTypeManager();
  $aliasStorage = $entityTypeManager->getStorage('path_alias');
  $nodeStorage = $entityTypeManager->getStorage('node');
  $ids = $aliasStorage->getQuery()
    ->accessCheck(FALSE)
    ->condition('alias', DatasetAliasManagerInterface::ALIAS_PREFIX, 'STARTS_WITH')
    ->execute();
  $deleted = 0;
  foreach (array_chunk($ids, 50) as $chunk) {
    /** @var \Drupal\path_alias\PathAliasInterface $alias */
    foreach ($aliasStorage->loadMultiple($chunk) as $alias) {
      if (!preg_match('@^/node/(\d+)$@', $alias->getPath(), $match)) {
        continue;
      }
      $node = $nodeStorage->load($match[1]);
      if ($node && $alias->getAlias() === DatasetAliasManagerInterface::ALIAS_PREFIX . $node->uuid()) {
        $alias->delete();
        $deleted++;
      }
    }
  }
  return $deleted;
}

/**
 * Add the distribution format field to the dkan search index (for facets).
 *
 * The dkan_dataset datasource already exposes distribution__item__format;
 * it is just not in dkan_metastore_search's shipped index. Marks the index
 * for reindexing when the field is added, and records that this module
 * added it so uninstall removes only what it created.
 */
function dkan_catalog_ui_ensure_format_index_field(): void {
  $index = Index::load('dkan');
  if (!$index || $index->getField('distribution__item__format')) {
    return;
  }
  \Drupal::state()->set(EntityHooks::FORMAT_FIELD_STATE_KEY, TRUE);
  $field = new Field($index, 'distribution__item__format');
  $field->setDatasourceId('dkan_dataset');
  $field->setPropertyPath('distribution__item__format');
  $field->setType('string');
  $field->setLabel('distribution__item__format');
  $index->addField($field);
  $index->save();
  $index->reindex();
}
